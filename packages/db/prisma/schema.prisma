// GoDigital Finance OS — Prisma schema
// Transcribed literally from Master Plan ДЕЛ II (v2.1 FINAL). Only МКД; money is Int денари.
// The @@unique / @unique constraints are LOAD-BEARING: they make duplicate import (B13) and
// double-billing (B15/B16) structurally impossible. Never relax one to make a test pass.
//
// Deviations from the Master Plan text (documented, valid-Prisma):
//  - The Expense <-> AdSpendReceipt 1:1 is owned by Expense.adSpendReceiptId (@unique). The
//    Master Plan also listed AdSpendReceipt.expenseId; a single 1:1 cannot hold a unique FK on
//    both sides, so AdSpendReceipt exposes it as the `expense` back-relation instead.
//  - User.passwordHash added for app-managed session auth (ADR-001 A3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============
enum PaymentChannel {
  INVOICE
  CASH
}

enum PayChannel {
  BANK
  CARD
  CASH
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum ChargeKind {
  INVOICE
  CASH_OBLIGATION
  CREDIT_NOTE
}

enum ChargeStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum LineType {
  SERVICE
  META_ADS
  ACTORS
  OTHER
}

enum BillingMode {
  PASSTHROUGH_ACTUAL
  FIXED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
}

enum MatchStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUAL_MATCHED
}

enum Direction {
  IN
  OUT
}

enum CashDocType {
  FISCAL
  KASA_PRIMI
  KASA_ISPLATI
}

// Expense categories are data (SM-99): the owner can add/rename custom categories. System categories
// (ADS/ACTORS/SALARY/HONORAR/BANK_FEES) carry billing/payroll/report logic — their `key` is immutable
// and they cannot be deleted; only the label is editable. `kind` keeps P&L grouping stable.
enum CategoryKind {
  OPERATING
  BILLABLE // pass-through to a client invoice (ADS/ACTORS — B15/B16)
  PAYROLL
  BANK
}

model Category {
  key         String       @id // stable code, e.g. "ADS" — referenced by Expense/VendorRule
  label       String // Macedonian display label (editable)
  system      Boolean      @default(false) // load-bearing: key immutable, undeletable
  kind        CategoryKind @default(OPERATING)
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  recurring   Boolean      @default(false) // SM-100: fixed monthly overhead → ТЕКОВНИ ТРОШОЦИ screen
  expenses    Expense[]
  vendorRules VendorRule[]
}

enum ContractorType {
  DOGOVOR_NA_DELO
  CONTRACTOR_INVOICE
}

enum TaxMode {
  WITHHOLD_10
  NO_WITHHOLDING
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum ImportSource {
  EMAIL
  MANUAL_UPLOAD
}

enum ImportStatus {
  PARSED
  DUPLICATE_SKIPPED
  FAILED
}

enum ParseStatus {
  OK
  PARTIAL
  FAILED
}

// ============ CLIENTS & CHARGING ============
model Client {
  id              String                  @id @default(cuid())
  name            String
  legalName       String? // полн правен назив за фактура (пр. „ДТУ СТАФФ 2014 ДОО"); fallback на name
  taxId           String? // ЕДБ — required за INVOICE (app-валидација)
  address         String?
  contactEmail    String?
  contactPhone    String?
  paymentChannel  PaymentChannel
  billingCycle    BillingCycle            @default(MONTHLY) // месечен / тромесечен наплата (SM-118) — по клиент, изменливо
  vatApplicable   Boolean                 @default(true)
  paymentTermDays Int                     @default(15)
  status          ClientStatus            @default(ACTIVE)
  number          Int?                    @unique // фиксен интерен број на клиент (нумерирање фактури SM-87)
  startDate       DateTime? // од кога клиентот е активен (гони W1 + тромесечен циклус)
  creditBalance   Int                     @default(0) // преплата → авто-примена на следен Charge (B18)
  contractUrl        String? // договор за соработка (PDF/слика), served via /api/attachments (SM-112)
  contractName       String? // оригинално име на прикачената датотека, за приказ
  contractUploadedAt DateTime?
  packages        ServicePackage[]
  lineTemplates   RecurringLineTemplate[]
  charges         Charge[]
  adAccounts      AdAccount[]
  bankAccounts    ClientBankAccount[]
  payments        Payment[]
  expenses        Expense[]
  createdAt       DateTime                @default(now())
}

// Жиро-сметки на клиент (SM-85). Влезна уплата се спарува по counterpartyAccount → клиент (SM-90),
// бидејќи кириличното име на плаќачот е нечитливо во PDF фонтот.
model ClientBankAccount {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  account   String   @unique // "300-0000052043-77"
  label     String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ServicePackage {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  monthlyAmount Int // ОСНОВИЦА за еден циклус, МКД integer дени (тромесечен = 3-месечна сума)
  billingCycle  BillingCycle @default(MONTHLY) // месечен / тромесечен (SM-88)
  description   String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdById   String
  createdAt     DateTime     @default(now())

  @@index([clientId])
}

model RecurringLineTemplate {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  type        LineType // META_ADS | ACTORS | OTHER
  billingMode BillingMode // META_ADS и ACTORS = PASSTHROUGH_ACTUAL (D2); OTHER = FIXED
  fixedAmount Int?
  active      Boolean     @default(true)

  @@index([clientId])
}

model Charge {
  id              String       @id @default(cuid())
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id])
  kind            ChargeKind
  period          String // "2026-08"
  seqInMonth      Int?
  invoiceNumber   String? @unique // легален број; null за CASH_OBLIGATION (NULL-ови се дозволени повеќе)
  internalRef     String? // интерна референца "1-{clientNo}/{M}-{YYYY}" (SM-87), за сите фактури
  issueDate       DateTime
  dueDate         DateTime
  status          ChargeStatus
  subtotal        Int // МКД
  vatAmount       Int // 0 за CASH_OBLIGATION
  total           Int
  paidAmount      Int          @default(0)
  relatedChargeId String? // CREDIT_NOTE → оригинал
  relatedCharge   Charge?      @relation("ChargeCorrection", fields: [relatedChargeId], references: [id])
  corrections     Charge[]     @relation("ChargeCorrection")
  lines           ChargeLine[]
  payments        Payment[]
  pdfUrl          String?

  // B12 relaxed (owner decision): multiple invoices per client per month are allowed. W1 still
  // generates the recurring charge once per (client, period, kind) via a findFirst idempotency guard;
  // extra invoices are added manually / by import.
  @@index([clientId, period, kind])
  @@unique([seqInMonth, period])
}

model ChargeLine {
  id             String    @id @default(cuid())
  chargeId       String
  charge         Charge    @relation(fields: [chargeId], references: [id])
  type           LineType
  description    String
  amount         Int
  vatRate        Float // 0.18 или 0
  sourceRefs     Json? // [{expenseId}] за META_ADS/ACTORS следливост
  billedExpenses Expense[] @relation("ExpenseBilledOnLine")

  @@index([chargeId])
}

model Payment {
  id              String           @id @default(cuid())
  clientId        String?
  client          Client?          @relation(fields: [clientId], references: [id])
  chargeId        String?
  charge          Charge?          @relation(fields: [chargeId], references: [id])
  channel         PayChannel
  amount          Int
  date            DateTime
  reference       String?
  matchStatus     MatchStatus
  statementLineId String?          @unique
  statementLine   StatementLine?   @relation(fields: [statementLineId], references: [id])
  cashEntryId     String?          @unique
  cashEntry       CashLedgerEntry? @relation(fields: [cashEntryId], references: [id])
}

// ============ CASH LEDGER (BLAGAJNA) ============
model CashLedgerEntry {
  id                String             @id @default(cuid())
  direction         Direction
  amount            Int
  date              DateTime
  description       String
  counterpartyType  String // CLIENT | CONTRACTOR | VENDOR | INTERNAL
  counterpartyId    String?
  documentType      CashDocType
  documentNumber    String? // број од фискалниот уред — рачен внес (D6)
  attachmentUrl     String? // задолжителна слика за исплати (B5)
  periodId          String
  period            Period             @relation(fields: [periodId], references: [id])
  createdById       String
  createdAt         DateTime           @default(now())
  payment           Payment?
  expense           Expense?
  contractorPayment ContractorPayment?

  @@index([periodId])
}

// ============ EXPENSES ============
model Expense {
  id                  String             @id @default(cuid())
  category            String // Category.key (SM-99); FK below
  categoryRef         Category           @relation(fields: [category], references: [key], onDelete: Restrict)
  vendor              String?
  amount              Int
  vatAmount           Int?
  date                DateTime
  paymentChannel      PayChannel
  clientId            String?
  client              Client?            @relation(fields: [clientId], references: [id])
  isBillable          Boolean            @default(false)
  billedOnLineId      String? // спречува двојно фактурирање (B15)
  billedOnLine        ChargeLine?        @relation("ExpenseBilledOnLine", fields: [billedOnLineId], references: [id])
  attachmentUrl       String?
  statementLineId     String?            @unique
  statementLine       StatementLine?     @relation(fields: [statementLineId], references: [id])
  cashEntryId         String?            @unique
  cashEntry           CashLedgerEntry?   @relation(fields: [cashEntryId], references: [id])
  adSpendReceiptId    String?            @unique
  adSpendReceipt      AdSpendReceipt?    @relation(fields: [adSpendReceiptId], references: [id])
  contractorPaymentId String? // D2: актер-ставка од алокација
  contractorPayment   ContractorPayment? @relation(fields: [contractorPaymentId], references: [id])
  ocrRaw              Json?
  asset               Asset?

  @@index([clientId])
  @@index([billedOnLineId])
  @@index([contractorPaymentId])
}

model Asset {
  id                String   @id @default(cuid())
  name              String
  purchaseExpenseId String   @unique
  purchaseExpense   Expense  @relation(fields: [purchaseExpenseId], references: [id])
  purchaseValue     Int
  depreciationRate  Float
  depreciationStart DateTime
}

// ============ META ADS PIPELINE ============
model AdAccount {
  id            String  @id @default(cuid())
  metaAccountId String  @unique // "2396006970755280"
  name          String
  clientId      String? // null = сопствен маркетинг
  client        Client? @relation(fields: [clientId], references: [id])
  active        Boolean @default(true)

  @@index([clientId])
}

model AdSpendReceipt {
  id               String         @id @default(cuid())
  emailMessageId   String         @unique // Gmail Message-ID — dedupe 1
  transactionId    String         @unique // dedupe 2
  metaInvoiceNo    String         @unique // "FBADS-..." — dedupe 3
  referenceNumber  String         @unique // "QEC8CTD652" — MATCHING КЛУЧ
  accountName      String
  metaAccountId    String?
  amountUsd        Int // центи — САМО за sanity-проверка
  cardLast4        String
  invoiceDate      DateTime
  campaignsJson    Json?
  attachmentUrl    String // оригинален PDF — законски документ
  reverseChargeVat Boolean        @default(true)
  parseStatus      ParseStatus
  matchStatus      MatchStatus    @default(UNMATCHED)
  statementLineId  String?        @unique
  statementLine    StatementLine? @relation(fields: [statementLineId], references: [id])
  expense          Expense? // 1:1 owned by Expense.adSpendReceiptId
  receivedAt       DateTime
}

// ============ БАНКА ============
model BankAccount {
  id             String                @id @default(cuid())
  bank           String                @default("NLB")
  accountNumber  String                @unique // "210-0768360001-38"
  openingBalance Int
  openingDate    DateTime
  imports        BankStatementImport[]
}

model BankStatementImport {
  id              String          @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount     @relation(fields: [bankAccountId], references: [id])
  statementNumber Int
  statementDate   DateTime
  source          ImportSource
  format          String          @default("NLB_PDF") // adapter pattern (D4)
  fileRef         String
  openingBalance  Int
  totalDebit      Int
  totalCredit     Int
  closingBalance  Int
  orderCount      Int
  status          ImportStatus
  lines           StatementLine[]

  @@unique([bankAccountId, statementNumber])
}

model StatementLine {
  id                  String              @id @default(cuid())
  importId            String
  import              BankStatementImport @relation(fields: [importId], references: [id])
  lineHash            String              @unique
  date                DateTime
  amount              Int
  direction           Direction
  counterpartyName    String?
  counterpartyAccount String?
  description         String
  reference           String?
  bankRef             String? // "Податоци за рекламација"
  classifiedAs        String? // META_ADS | CARD_TX | CLIENT_PAYMENT | BANK_FEE | OTHER
  processed           Boolean             @default(false)
  linkedType          String?
  linkedId            String?
  payment             Payment?
  expense             Expense?
  adSpendReceipt      AdSpendReceipt?
  loanEntry           LoanEntry?

  @@index([importId])
}

model VendorRule {
  id          String   @id @default(cuid())
  pattern     String
  category    String // Category.key (SM-99)
  categoryRef Category @relation(fields: [category], references: [key], onDelete: Restrict)
  vendor      String?
  hits        Int      @default(0)
}

model ExchangeRate {
  id     String   @id @default(cuid())
  date   DateTime
  code   String   @default("USD")
  midMkd Float

  @@unique([date, code])
}

// ============ ЛУЃЕ ============
model Contractor {
  id           String              @id @default(cuid())
  name         String
  idNumber     String?
  contractType ContractorType
  taxMode      TaxMode // B8: NO_WITHHOLDING само со CONTRACTOR_INVOICE
  isTalent     Boolean             @default(false) // D2: актер/on-camera — алокациите можат да се билабилни
  defaultRate  Int?
  contractUrl  String?
  active       Boolean             @default(true)
  payments     ContractorPayment[]
}

model ContractorPayment {
  id             String           @id @default(cuid())
  contractorId   String
  contractor     Contractor       @relation(fields: [contractorId], references: [id])
  period         String
  grossAmount    Int
  taxAmount      Int
  netAmount      Int
  paymentChannel PayChannel
  cashEntryId    String?          @unique
  cashEntry      CashLedgerEntry? @relation(fields: [cashEntryId], references: [id])
  documentUrl    String?
  allocations    Json // [{clientId, amount, billable}] — D2
  status         String // CALCULATED | PAID
  expenses       Expense[] // billable ACTORS Expenses (D2, B16)

  @@index([contractorId])
}

model Employee {
  id          String  @id @default(cuid())
  name        String
  grossSalary Int
  position    String?
}

model PayrollRun {
  id     String @id @default(cuid())
  period String
  items  Json
  status String
}

// ============ СИСТЕМ ============
model Period {
  id          String            @id // "2026-08"
  status      PeriodStatus      @default(OPEN)
  closedAt    DateTime?
  closedById  String?
  cashEntries CashLedgerEntry[]
  loanEntries LoanEntry[]
}

// SM-100/SM-102: owner/private-person loans — a financing flow (liability/receivable), never revenue
// or expense. Four kinds (SM-102): RECEIVED (примена, IN) / REPAID (поврат, OUT) form the company's
// liability; GIVEN (дадена, OUT) / COLLECTED (наплата, IN) form its receivable. Never touches
// Charges/Expenses or P&L. Rule #1: linked to its bank line.
enum LoanKind {
  RECEIVED // примена — a person lent to the company (IN)
  REPAID // поврат — the company paid a person back (OUT)
  GIVEN // дадена — the company lent to a person (OUT)
  COLLECTED // наплата — a person paid the company back (IN)
}

model LoanEntry {
  id              String         @id @default(cuid())
  lenderName      String
  direction       Direction // bank direction of the line (IN/OUT)
  kind            LoanKind       @default(RECEIVED) // SM-102: primena/поврат/дадена/наплата
  amount          Int // дени
  date            DateTime
  note            String?
  attachmentUrl   String? // договор за заем (по желба)
  statementLineId String?        @unique
  statementLine   StatementLine? @relation(fields: [statementLineId], references: [id])
  periodId        String
  period          Period         @relation(fields: [periodId], references: [id])
  createdById     String
  createdAt       DateTime       @default(now())

  @@index([lenderName])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  diff      Json
  userId    String
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  role         String
  passwordHash String // app-managed session auth (ADR-001 A3)
}

// SM-113 — issuer identity + invoice settings (Master Plan D1: entity data lives in config, never
// hardcoded in business logic). Singleton row (id = "default"). Seeded with the АЛМА ДИЗАЈН data.
model CompanyProfile {
  id            String   @id @default("default")
  name          String
  address       String
  phone         String?
  email         String?
  taxId         String // ЕДБ на издавачот
  bankName      String
  account       String // жиро-сметка
  director      String // управител (потпис)
  invoiceFooter String // клаузули на дното на фактурата
  updatedAt     DateTime @updatedAt
}

// SM-111 — durable, acknowledgeable alarm record for import/worker integrity failures (Master Plan
// §13, B14, §4.4). Raised alongside the structured log; best-effort emailed. Not append-only forever:
// a writer acknowledges it (stamps acknowledgedAt/acknowledgedById) — the row itself is never edited
// otherwise and never deleted.
enum AlertType {
  INTEGRITY_FAILED
  CONTINUITY_GAP
  IMPORT_FAILED
  RATE_SANITY
  MATCH_ERROR
}

model SystemAlert {
  id               String    @id @default(cuid())
  type             AlertType
  severity         String // "error" | "warn"
  title            String
  detail           String
  context          Json?
  createdAt        DateTime  @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?

  @@index([acknowledgedAt, createdAt])
}
