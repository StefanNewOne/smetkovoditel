# SM-120 — Local install config. Copy to `Install/.env.install` (gitignored) and fill the
# generated secrets. install.ps1 does this for you on first run.
#
# SAFETY: GMAIL_* is intentionally left EMPTY. With no Gmail credentials the app sends NO
# outbound email (createMailSender() -> null) and does NO Gmail ingestion — zero risk of
# emailing a real client while you work locally. Import statements/receipts manually via the UI.

# ── App / auth ──────────────────────────────────────────────────────────────
NODE_ENV=production
# Internal service DNS name inside the compose network (NOT localhost).
DATABASE_URL=postgresql://smetko:smetko@db:5432/smetko?schema=public
APP_URL=http://localhost:3000
# 32+ char secret for the iron-session cookie. install.ps1 generates a random value.
SESSION_SECRET=CHANGE_ME_generated_by_install_script
LOG_LEVEL=info

# ── Cron (W1 charges, W7 rate) ──────────────────────────────────────────────
CRON_SECRET=CHANGE_ME_generated_by_install_script

# ── Gmail — LEAVE EMPTY for the safe local month (see SAFETY note above) ─────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GMAIL_POLL_MINUTES=12

# ── Object storage (attachments) — internal MinIO over the compose network ──
STORAGE_DIR=/app/uploads
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
S3_BUCKET=smetko-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Exchange rate (W7) — optional; empty = W7 rate refresh is a no-op ───────
NBRM_RATE_URL=
