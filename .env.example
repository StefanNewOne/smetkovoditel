# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (app + worker).
DATABASE_URL="postgresql://smetko:smetko@localhost:5434/smetko?schema=public"

# ── App / auth ────────────────────────────────────────────────────────────
NODE_ENV="development"
# 32+ char secret used to encrypt the iron-session cookie. Generate a random value.
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Public base URL of the app (used for invoice links, OAuth redirect, emails).
APP_URL="http://localhost:3000"

# ── Gmail ingestion + outbound (Master Plan §4.1, §11) ────────────────────
# OAuth2 credentials for the single ingestion mailbox (Meta receipts + NLB statements).
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
# From-address used to send invoices / dunning reminders.
GMAIL_SENDER="fakturi@example.com"
# How often the worker polls the mailbox, in minutes (Master Plan §4.1: 10–15).
GMAIL_POLL_MINUTES="12"

# ── Exchange rate (W7) ────────────────────────────────────────────────────
# НБРМ USD mid-rate source. Used ONLY for Meta ±6% sanity, never for booking (D3).
NBRM_RATE_URL=""

# ── Object storage (attachments) ──────────────────────────────────────────
# Local dev uses MinIO; production swaps to an S3-compatible endpoint. Retention ≥ 10y.
# Local fallback attachment dir (used until S3/MinIO is wired). Served via /api/attachments.
STORAGE_DIR="./uploads"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-central-1"
S3_BUCKET="smetko-attachments"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ── Cron ──────────────────────────────────────────────────────────────────
# Secret guarding the HTTP cron-trigger endpoints (W1, W7 manual runs).
CRON_SECRET="change-me"

# ── Deploy (read at runtime by scripts/deploy.sh — never commit real values) ─
VPS_IP=""
DEPLOY_SSH_USER=""
DEPLOY_SSH_PRIVATE_KEY=""
BACKUP_TARGET=""
